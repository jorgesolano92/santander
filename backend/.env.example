# Copiar a .env y ajustar valores.
# DEBUG=true
# Prefijo REST (debe coincidir con el proxy Vite: rutas /api/...). No dejar API_PREFIX vacío.
# API_PREFIX=/api
# DATABASE_URL=sqlite:///./data/control_accesos.db
# STATE_SAVE_INTERVAL_SECONDS=60
# EVENTS_RETENTION_DAYS=180

# Producción: si el build del frontend está en backend/static (y no en ../frontend/dist):
# STATIC_DIR=./static

# Transporte Modbus:
# - tcp: usa host/port por módulo (panel_modules)
# - rtu: usa bus RS-485 compartido y slave_id por módulo
# MODBUS_MODE=tcp
# MODBUS_TIMEOUT=3
# MODBUS_RETRIES=1
# MODBUS_SERIAL_PORT=COM7
# MODBUS_SERIAL_BAUDRATE=9600
# MODBUS_SERIAL_BYTESIZE=8
# MODBUS_SERIAL_PARITY=N
# MODBUS_SERIAL_STOPBITS=1

# API tablet v1 (JWT). En producción: TABLET_JWT_SECRET largo y aleatorio.
# TABLET_JWT_SECRET=
# TABLET_JWT_EXPIRE_MINUTES=10080
# Si vacío: solo el 1er usuario sin cabecera; más usuarios → definir token y cabecera.
# TABLET_SETUP_TOKEN=

# Panel web (JWT propio). En producción: PANEL_JWT_SECRET largo y aleatorio.
# PANEL_JWT_SECRET=
# PANEL_JWT_EXPIRE_MINUTES=10080
# PANEL_SETUP_TOKEN=

# ETD8A12: al conectar TCP, escribir 0 en relation_register del módulo para desacoplar IN/OUT de fábrica.
# Probar en banco; algunas revisiones cierran el socket. Ver manual (0xFA vs 0x0030 según firmware).
ETD_DISABLE_IN_OUT_ASSOCIATION_ON_CONNECT=true

# Por defecto el backend usa TCP (placas por IP). RS-485 solo si MODBUS_MODE=rtu.
MODBUS_MODE=rtu
MODBUS_TIMEOUT=3
MODBUS_RETRIES=1
# En cada barrido de I/O, leer también relation_register (IN↔OUT). false = menos lecturas Modbus por placa.
# PANEL_POLL_IN_OUT_RELATION_REGISTER=true
# Reglas: triggers/bloqueos leen IN físico (Modbus) ignorando simulación del panel. false = IN “efectivo” con overrides.
# PANEL_RULES_TRIGGERS_USE_PHYSICAL_INPUTS=true
# Tras N lecturas I/O fallidas seguidas se marca la placa desconectada (histéresis RTU). Por defecto 3.
# PANEL_MODBUS_READ_FAILURES_BEFORE_DISCONNECT=3
# Solo aplican si MODBUS_MODE=rtu (en remoto sin adaptador USB, dejar tcp y omitir COM).
MODBUS_SERIAL_PORT=COM7
MODBUS_SERIAL_BAUDRATE=9600
MODBUS_SERIAL_BYTESIZE=8
MODBUS_SERIAL_PARITY=N
MODBUS_SERIAL_STOPBITS=1

# Ciclo automático reglas + lectura Modbus (pulsadores). 0.25 ≈ 4 lecturas/s; RTU: no bajar mucho.
# AUTO_RULES_BACKGROUND_ENABLED=true
# AUTO_RULES_BACKGROUND_INTERVAL_SECONDS=0.25

# Panphone / CSIP custom1. notification_url en cada placa:
#   http://<backend>/api/csip/notify/p1   (o /p2, /p3, …)
# Proxy hacia placas: /api/csip/device/*
CSIP_ENABLED=true
# N Panphones (p1=.70, p2=.80; mismo token; añade p3… con la misma forma).
# "led" = canal LED en esa placa (suele ser p1 si solo hay un botón).
CSIP_DEVICES={"p1":{"base_url":"http://192.168.1.70:8090/api/custom1","token":"f3fb37ac959b795507cf3d6794b1f29b91ed2b1b1d1f06c6","led":"p1"},"p2":{"base_url":"http://192.168.1.80:8090/api/custom1","token":"f3fb37ac959b795507cf3d6794b1f29b91ed2b1b1d1f06c6","led":"p1"}}
# Token por defecto si un device no trae "token" propio (legacy / fallback).
CSIP_API_TOKEN=f3fb37ac959b795507cf3d6794b1f29b91ed2b1b1d1f06c6
CSIP_FORWARD_PULSACION_TO_ZAGUAN=true
CSIP_TIMEOUT_S=20
# Brillo LED Panphone (1–9). Vacío/omitir = no enviar brightness.
CSIP_LED_BRIGHTNESS=5
# Legacy (1 sola placa): descomentar y vaciar CSIP_DEVICES si no usáis el mapa.
# CSIP_BASE_URL=http://192.168.1.70:8090/api/custom1
# CSIP_WEBHOOK_TOKEN=

# Canal COCE central (WebSocket saliente + heartbeat). Token al crear sucursal en dashboard.
# COCE_WS_ENABLED=true
# COCE_WS_URL=ws://localhost:9000/api/coce/ws/branch/<installation_id>
# COCE_INSTALLATION_ID=<uuid de la sucursal en coce-api>
# COCE_INGEST_TOKEN=<generado al alta, una sola vez>
# COCE_HEARTBEAT_INTERVAL_SECONDS=60
# COCE_RECONNECT_SECONDS=5
# Mensajes COCE: el COCE solo habla con este backend. Aquí se reparte:
#   COCE_MESSAGE_SEND_WEB=true     → toast/historial en dashboard panel (/api/panel/ws/live)
#   COCE_MESSAGE_SEND_TABLET=true  → push a tablets por /api/v1/ws/calls (mismo canal que modos/llamadas)
# Con WEB=false y TABLET=true el mensaje no se muestra en el panel web, pero sí llega a tablets.
# COCE_MESSAGE_SEND_TABLET=true
# COCE_MESSAGE_SEND_WEB=true
# Zaguán: 1 = solo captura pulsaciones/LED, sin abrir puerta Modbus; 0 = abrir puerta
ZAGUAN_PULSACION_CAPTURE_ONLY=0
# ESP32 zaguán (saliente backend → LED). IP/puerto por defecto; overrides por canal en data/zaguan_device_target.json
# ZAGUAN_DEVICE_HOST=192.168.1.60
# ZAGUAN_DEVICE_PORT=8000
# ZAGUAN_DEVICE_TIMEOUT_S=2
# Ejemplo zaguan_device_target.json (4 ESP, un canal lógico por placa):
# {
#   "host": "192.168.1.60",
#   "port": 8000,
#   "timeout_s": 2,
#   "channels": {
#     "p1": { "host": "192.168.1.60", "port": null },
#     "p2": { "host": "192.168.1.62", "port": null },
#     "p3": { "host": "192.168.1.61", "port": null },
#     "p4": { "host": "192.168.1.63", "port": null }
#   }
# }
# p1 videoportero P1 ext · p3 pulsador P1 ext · p2 videoportero P2 int · p4 pulsador P2 int
# Canal vacío en channels → usa host/port global (fallback).
# Copiar en backend/.env de la sucursal
COCE_WS_ENABLED=true
COCE_WS_URL=ws://10.147.17.142:9000/api/coce/ws/branch/a418670f-3ec1-430c-94a6-b47e5e3562ef
COCE_INSTALLATION_ID=a418670f-3ec1-430c-94a6-b47e5e3562ef
COCE_INGEST_TOKEN=UYaM_PfxupaAJ5IG_2H8Ulaj4sDhjeMb7RVfrilSvng