# Copiar a .env y ajustar en producción
COCE_DEBUG=true
COCE_HOST=0.0.0.0
COCE_PORT=9000
COCE_DATABASE_URL=sqlite:///./data/coce.db
COCE_JWT_SECRET=cambiar-en-produccion-coce-jwt
COCE_JWT_EXPIRE_MINUTES=480
# Clave Fernet (32 bytes url-safe base64). Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COCE_SECRETS_KEY=
COCE_SETUP_TOKEN=
COCE_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# true = CORS desde cualquier URL (dev). En producción usar COCE_CORS_ORIGINS con orígenes concretos.
COCE_CORS_ALLOW_ALL=false
# WebSocket ingest sucursal (API key por sucursal). En dev: false si aún no hay token en BD.
COCE_BRANCH_AUTH_REQUIRED=true
COCE_BRANCH_HEARTBEAT_TIMEOUT_SECONDS=120
# Checkout del código panel sucursal (backend/ + frontend/) para «Publicar desde local»
# COCE_PANEL_SOURCE_DIR=C:/Users/Jorge/proyectos/santander
# COCE_UPDATES_MAX_UPLOAD_MB=256
